# test environment. Copy to .env.test and fill the real values.
# .env.* files are gitignored; this file and .env.test are the only ones committed.
NODE_ENV=test
PORT=5055
HOSTNAME=0.0.0.0

# CORS allowlist as a JSON array. The browser can only call the API from these origins.
ORIGINS=["http://localhost:3000"]
ROOT_DOMAIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
SERVER_DOMAIN=localhost

# Postgres
POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/app

# Redis (cache, sessions, pub/sub, queues)
REDIS_URI=redis://localhost:6379
REDIS_CHANNEL_PREFIX=

