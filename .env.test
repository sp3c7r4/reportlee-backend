# 32 bytes, hex or base64. Encrypts values that must not sit in the database in the clear.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=c098f74bf812eb8cc96cca15fc23c62fdc6845815fe1c70099cae9d82f124961

# Mail: ses | resend. Both credential sets can be present; the provider picks one.
MAIL_PROVIDER=resend
MAIL_DOMAIN=example.com
MAIL_FROM_NAME=My App
# Absolute URL of the logo in every email header; leave empty to omit it.
MAIL_LOGO_URL=
RESEND_API_KEY=
RESEND_DOMAIN=mail.example.com

# S3-compatible storage for uploads (AWS, MinIO, R2, ...)
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=app-uploads
# Set only for a non-AWS endpoint; forces path-style addressing.
AWS_S3_ENDPOINT=
# Public base for objects, e.g. https://cdn.example.com/ or a bucket URL ending in /
CDN_URL=http://localhost:9000/app-uploads/
